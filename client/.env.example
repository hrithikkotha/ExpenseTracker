# ── Client environment ──────────────────────────────────────────
# Copy to `.env`. All Vite client vars must be prefixed with VITE_.

# Base URL for the API.
# Dev: Use /api/v1 (Vite proxy forwards to http://localhost:4000)
# Production (monorepo on Render): Use /api/v1 (same origin)
# Production (separate hosts): Use https://your-api.onrender.com/api/v1
VITE_API_URL=/api/v1
