# ── Server environment (Phase 0) ────────────────────────────────
# Copy this file to `.env` and fill in real values.

# Runtime
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB connection string (MongoDB Atlas or local mongod)
# Local example:  mongodb://127.0.0.1:27017/expense_tracker
# Atlas example:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/expense_tracker
MONGODB_URI=mongodb+srv://21d41a0597:<db_password>@cluster0.4mhgi.mongodb.net/expense_tracker?appName=Cluster0

# ── Auth (Phase 1) ──────────────────────────────────────────────
# Secret used to sign JWT access tokens. MUST be a strong random string
# in production (>= 16 chars). A dev default is used if omitted locally.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=dev-insecure-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
REFRESH_COOKIE_NAME=et_rt

# ── Reserved for later phases (not used yet) ────────────────────
# ADMIN_EMAIL=
