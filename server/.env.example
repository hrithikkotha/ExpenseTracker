# ── Server environment (Phase 0) ────────────────────────────────
# Copy this file to `.env` and fill in real values.

# Runtime
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB connection string (MongoDB Atlas or local mongod)
# Local example:  mongodb://127.0.0.1:27017/expense_tracker
# Atlas example:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/expense_tracker
MONGODB_URI=mongodb://127.0.0.1:27017/expense_tracker

# ── Reserved for later phases (not used yet) ────────────────────
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=7d
# ADMIN_EMAIL=
